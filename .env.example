# Copier ce fichier en .env et renseigner les valeurs réelles (.env est ignoré par git).

# Identifiant admin unique (back-office, pas de système multi-utilisateurs).
ADMIN_USERNAME=admin

# Hash bcrypt du mot de passe admin — ne JAMAIS mettre le mot de passe en clair ici.
# Générer via : python scripts/generate_admin_hash.py
ADMIN_PASSWORD_HASH=

# Secret de signature des JWT. Générer une valeur aléatoire sécurisée via :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ne jamais réutiliser une valeur d'exemple ou versionnée en production.
JWT_SECRET_KEY=

# Durée de validité du token (en minutes) avant ré-authentification requise.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Tâche planifiée de récupération des rapports de blessures NBA (désactivée par défaut).
ENABLE_INJURY_SCHEDULER=false

# Clé API balldontlie.io (compte gratuit sur app.balldontlie.io) pour la
# synchronisation automatique des scores.
BALLDONTLIE_API_KEY=

# Tâche planifiée de synchronisation des scores via balldontlie.io (désactivée par défaut).
ENABLE_SCORES_SCHEDULER=false

# Origines autorisées (CORS) pour le frontend Vue.js — plusieurs valeurs séparées
# par des virgules. À ajuster une fois le port/domaine confirmé à l'Étape 5.
CORS_ALLOWED_ORIGINS=http://localhost:5173
